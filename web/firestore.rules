rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isStaffUp() {
      return signedIn() && (myRole() == 'staff' || myRole() == 'admin');
    }
    // The simulated wallet transfers credits to another person's wallet. A
    // signed-in user may only ever ADD to someone else's balance (a credit),
    // never take from it. The owner/staff rule above still covers debits.
    function walletCreditOk(uid) {
      return signedIn()
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && (!exists(/databases/$(database)/documents/wallets/$(uid))
            || (request.resource.data.balance > resource.data.balance
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])));
    }

    // Users: anyone can create ONLY their own doc as role 'user'.
    // Only admins can change roles. Make your first admin by editing the role in the Firebase console.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaffUp());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'user';
      // Admins can change anything. Everyone else can edit their own doc,
      // but NOT their own role and NOT their own "active" flag (so a deactivated
      // account can't switch itself back on).
      allow update: if signedIn() && (isAdmin() || (request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('active', true) == resource.data.get('active', true)));
      allow delete: if isAdmin();
    }

    // Public profiles: a tiny safe mirror of users (uid, name, email) that any
    // signed-in person can read. It exists so features like the wallet can show
    // a recipient list without exposing the full private users collection.
    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.keys().hasOnly(['uid', 'name', 'email']);
      allow delete: if isAdmin();
    }

    // Support requests: filed when a user cannot complete any verification
    // method (the staff-assisted fallback). Staff can read and resolve them.
    match /support_requests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'open';
      allow read: if isStaffUp() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isStaffUp();
    }

    match /logs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaffUp() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /notifications/{id} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
      // You can notify yourself; only staff/admin can notify other people
      allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || isStaffUp());
    }

    // DEMO collection for the CRUD kit. For each new topic collection, copy this block.
    match /items/{id} {
      allow read: if signedIn();
      allow write: if isStaffUp();
    }

    // Announcements: everyone signed in reads, only staff/admin post or delete.
    match /announcements/{id} {
      allow read: if signedIn();
      allow create, delete: if isStaffUp();
      allow update: if isAdmin();
    }

    // TOTP secret + hashed recovery codes: owner only (staff can NOT read these)
    match /totp/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /sms_outbox/{id} {
      allow create: if signedIn();
      allow read: if isStaffUp();
    }

    // Login history: a user can write their own row and read only their own.
    match /login_history/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Trusted devices: owner only.
    match /trusted_devices/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // WebAuthn credential ids: owner only.
    match /webauthn_credentials/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Face descriptors: owner only. Never store images here.
    match /face_descriptors/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Wallets: the owner (and staff) can read/write. Any signed-in user may
    // credit another wallet (the recipient side of a simulated transfer), but
    // never debit it.
    match /wallets/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaffUp());
      allow write: if signedIn() && (request.auth.uid == uid || isStaffUp() || walletCreditOk(uid));
    }

    // Transactions: owner reads; a sender writes both sides of a simulated
    // transfer (their own debit row and the recipient's credit row), so a row
    // is allowed when the signed-in user is either the owner or the sender.
    match /transactions/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaffUp());
      allow create: if signedIn() && (request.resource.data.uid == request.auth.uid
                    || request.resource.data.get('fromUid', '') == request.auth.uid);
    }

    // Check-ins: users create/read their own; staff read all.
    match /checkins/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaffUp() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // AI chat history: owner only. Reads look at the stored doc (resource),
    // writes at the incoming doc (request.resource) — mixing them blocks reads.
    match /ai_chats/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
  }
}
